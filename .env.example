# Copy to .env and adjust. No secrets committed — these are non-sensitive local defaults.

POSTGRES_PORT=5432
POSTGRES_DB=otpsentinel
POSTGRES_USER=otpsentinel
POSTGRES_PASSWORD=otpsentinel

AI_MODE=stub
AI_MAX_TOOL_CALLS=8
AI_MAX_REPAIR_ATTEMPTS=1
AI_TIMEOUT_SECONDS=20
RAG_TOP_K=5
RAG_MIN_SCORE=0.70
INVESTIGATION_MAX_SECONDS=30
TOOL_TIMEOUT_MILLIS=2000
TOOL_RETRY_COUNT=1
DEMO_FIXTURE=OTP-DROP-001

# local-live / demo profilinde (bkz. docs/16-adr.md ADR-015) — gerçek key .env'de, buraya yazma
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_CHAT_MODEL=
# M4 compatibility spike doğrulandı: 1024 boyut, input_type (query/passage) destekli (docs/16 ADR-015).
NVIDIA_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
